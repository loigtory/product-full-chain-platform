# Active Express workbench. Values are injected from ignored local configuration.
PORT=5188
# Explicit modes only: memory demonstration (default), or pre-migrated PG. auto is rejected.
PFC_DB=memory
DATABASE_URL=
# PG requires a private secret of at least 32 characters; no default secret is accepted.
JWT_SECRET=
# Exact disposable schema for verification, or reviewed pfc_workbench. No schema is created at startup.
PFC_DB_SCHEMA=
PFC_AUTHORIZED_SCHEMA=
# Ignored .local JSON array: [{name,role,tenantId}]. owner/executor/viewer; body.role cannot change it.
PFC_LOCAL_USERS_FILE=
# Tests: per-attempt .local/m2c-2-domain-20260912/files; workbench: exact .local/pfc-workbench-files.
# Business directory/schema/tenant initialization requires the separately approved activation plan in 28.
PFC_FILES_ROOT=
# Explicit bytes, maximum 104857600 in the current local profile.
PFC_FILE_QUOTA_BYTES=
# Explicit CLI migrations only; see migrate-m2c.mjs --schema NAME --target-version 002.
PFC_M2C_AUTHORIZED_SCHEMA=
