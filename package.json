{
  "name": "product-full-chain-platform",
  "version": "0.0.0",
  "private": true,
  "description": "PC product requirement lifecycle platform",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:config": "node scripts/check-config.mjs",
    "check:codex-protocol": "node scripts/check-codex-protocol.mjs",
    "check:delivery-governance": "node --import tsx scripts/check-delivery-governance.ts",
    "check:ui-design": "node scripts/check-ui-governance.mjs",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit --pretty false",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration --maxWorkers=1",
    "test:e2e:pc": "node --import tsx scripts/run-playwright-projects.ts",
    "test:permission": "vitest run tests/unit/access-policy.test.ts tests/unit/authorization-service.test.ts tests/unit/question-application.test.ts tests/unit/material-impact-application.test.ts tests/integration/requirements-api.test.ts tests/integration/questions-api.test.ts tests/integration/material-impact-timeline-api.test.ts --maxWorkers=1",
    "test:concurrency": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration/t3-requirements-persistence.test.ts tests/integration/t4-questions-persistence.test.ts tests/integration/t5-gate-runs-persistence.test.ts tests/integration/t6-material-impact-persistence.test.ts --maxWorkers=1",
    "test:recovery": "vitest run tests/unit/requirements-ui.test.tsx tests/unit/question-drawer.test.tsx tests/unit/gate-run-panel.test.tsx tests/unit/material-impact-timeline-panel.test.tsx tests/integration/gate-runs-api.test.ts tests/integration/material-impact-timeline-api.test.ts --maxWorkers=1",
    "test:security": "vitest run tests/unit/security-policy.test.ts tests/unit/access-policy.test.ts tests/unit/authorization-service.test.ts tests/unit/outbox.test.ts tests/unit/server-health.test.ts --maxWorkers=1",
    "test:performance": "vitest run tests/performance --maxWorkers=1",
    "check:security": "node --import tsx scripts/security-check.ts",
    "db:test-cleanup-check": "node --env-file-if-exists=.env.local scripts/check-test-schema-cleanup.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:migrate:plan": "node --import tsx scripts/migrate.ts --dry-run",
    "db:migrate:m1-preflight": "node --env-file-if-exists=.env.local --import tsx scripts/preflight-m1-migration.ts",
    "db:migrate:m2-r2-preflight": "node --env-file-if-exists=.env.local --import tsx scripts/preflight-m2-r2-migration.ts",
    "db:migrate:ai-ux-preflight": "node --env-file-if-exists=.env.local --import tsx scripts/preflight-ai-ux-standard-migration.ts",
    "db:migrate:ai-ux": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-ai-ux-local.ts",
    "db:migrate:ai-ux-readback": "node --env-file-if-exists=.env.local --import tsx scripts/read-ai-ux-standard-migration.ts",
    "db:migrate:m2-r2": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-m2-r2-local.ts",
    "local:admin:init": "node --env-file-if-exists=.env.local --import tsx scripts/init-local-admin.ts",
    "local:skill:register-m2-r1": "node --env-file-if-exists=.env.local --import tsx scripts/register-m2-r1-skill.ts",
    "local:skill:register-m2-r2": "node --env-file-if-exists=.env.local --import tsx scripts/register-m2-r2-skill.ts",
    "local:skill:register-ai-product-work": "node --env-file-if-exists=.env.local --import tsx scripts/register-ai-product-work-skill.ts",
    "local:m2:r2:acceptance:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-m2-r2-local-acceptance.ts",
    "local:m2:r2:acceptance:pair": "node --env-file-if-exists=.env.local --import tsx scripts/pair-m2-r2-local-acceptance.ts",
    "test:m2:r2:acceptance:api": "node --env-file-if-exists=.env.local --import tsx scripts/accept-m2-r2-local.ts",
    "test:m2:r2:acceptance:browser": "node --env-file-if-exists=.env.local --import tsx scripts/accept-m2-r2-browser.ts",
    "test:m2:r2:acceptance:readback": "node --env-file-if-exists=.env.local --import tsx scripts/read-m2-r2-closeout.ts",
    "test:m2:r2:recover-unknown": "node --env-file-if-exists=.env.local --import tsx scripts/recover-m2-r2-unknown.ts",
    "test:m2:r2:exercise-unknown": "node --env-file-if-exists=.env.local --import tsx scripts/exercise-m2-r2-unknown.ts",
    "local:m2:acceptance:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-m2-local-acceptance.ts",
    "local:m2:acceptance:pair": "node --env-file-if-exists=.env.local --import tsx scripts/pair-m2-local-acceptance.ts",
    "test:m2:acceptance:live": "node --env-file-if-exists=.env.local --import tsx scripts/accept-m2-local.ts",
    "test:m2:r2:app-server": "node --env-file-if-exists=.env.local --import tsx scripts/spikes/m2-r2-app-server-spike.ts",
    "test:ai-ux:r1:c:live": "node --env-file-if-exists=.env.local --import tsx scripts/accept-ai-ux-r1-c-local.ts",
    "test:ai-ux:r1:d:browser": "node --env-file-if-exists=.env.local --import tsx scripts/accept-ai-ux-r1-d-browser.ts",
    "local:m2:run:evidence": "node --env-file-if-exists=.env.local --import tsx scripts/read-m2-run-evidence.ts",
    "local:bridge:pair": "node --env-file-if-exists=.env.local --import tsx apps/bridge/src/pair.ts",
    "local:bridge:start": "node --env-file-if-exists=.env.local --import tsx apps/bridge/src/main.ts",
    "db:experience:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-local-experience.ts",
    "db:experience:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-local-experience.ts",
    "test:experience:live": "node --import tsx scripts/accept-local-experience.ts",
    "build": "npm run build --workspaces --if-present",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-postgres.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:gate:quick": "node scripts/run-gate.mjs quick",
    "test:gate:core": "node scripts/run-gate.mjs core",
    "test:gate:full": "node scripts/run-gate.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "diff": "9.0.0"
  }
}
